# Copy to .env (gitignored) next to docker-compose.yml. Never commit .env.

# ---- Compose ----
# Your Docker Hub username (images are <user>/achilles-backend and <user>/achilles-frontend).
DOCKERHUB_USER=your-dockerhub-username
# Image tag to run: latest (newest main), a branch name, or sha-<commit>.
ACHILLES_TAG=latest
# Where the website container listens on the host. On a server behind nginx (deploy/setup-https.sh)
# use 127.0.0.1 + 3000 so only nginx is public. 0.0.0.0 = reachable from other machines directly.
ACHILLES_WEB_BIND=127.0.0.1
ACHILLES_WEB_PORT=3000

# ---- Shared secret ----
# Any long random string. Compose passes the same value to the backend and the frontend proxy.
ACHILLES_API_KEY=change-me-to-something-long

# ---- Scan history ----
# Atlas: Connect -> Drivers -> mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
# Also allow this server's public IP under Atlas -> Network Access.
# Empty = history kept in the achilles-data Docker volume.
ACHILLES_MONGODB_URI=
ACHILLES_MONGODB_DB=achilles

# ---- Scanner behaviour ----
# Hosts you run yourself. They skip ownership verification. Never list a third-party host.
ACHILLES_LAB_TARGETS=
ACHILLES_FAKE_TOOLS=0
ACHILLES_MAX_CONCURRENT_SCANS=1
ACHILLES_CORS_ORIGINS=*

# ---- Optional AI fix writer ----
# Without keys the built-in rule table writes the fixes.
ACHILLES_AI_ORDER=grok,gemini,claude
ACHILLES_XAI_API_KEY=
ACHILLES_GEMINI_API_KEY=
ACHILLES_ANTHROPIC_API_KEY=
