# Copy to .env and edit. ./run.sh loads this file.

# Where the API listens. 0.0.0.0 = reachable from other machines on the LAN.
ACHILLES_HOST=0.0.0.0
ACHILLES_PORT=8000

# Shared secret. Teammates send it as the X-API-Key header. Set this before exposing on the LAN.
ACHILLES_API_KEY=change-me-to-something-long

# Browser origins allowed to call the API (frontend dev server, deployed site). * = any.
ACHILLES_CORS_ORIGINS=*

# Hosts/IPs you run yourself (e.g. the seeded test app or Juice Shop on the LAN).
# These skip the ownership check AND the private-address block. Never list a third-party host.
ACHILLES_LAB_TARGETS=

# 1 = return realistic canned results without running any tool (frontend work, or wifi-dead demo backup).
ACHILLES_FAKE_TOOLS=0

# Scans running at once (each scan already runs 5 tools in parallel). Keep 1 on a small VM.
ACHILLES_MAX_CONCURRENT_SCANS=1

# Only set these if auto-detection picks the wrong binary.
# ACHILLES_HTTPX_BIN=$HOME/go/bin/httpx
# ACHILLES_NUCLEI_BIN=$HOME/go/bin/nuclei
# ACHILLES_TESTSSL_BIN=/usr/bin/testssl

# AI fix writer. Order of providers and their keys; any provider without a key is skipped, and the
# built-in rule table is always the last fallback, so scans work with none of these set.
# Setting a key means finding titles/locations (secrets already masked) are sent to that provider.
ACHILLES_AI_ORDER=grok,gemini,claude
# ACHILLES_XAI_API_KEY=
# ACHILLES_XAI_MODEL=grok-4
# ACHILLES_GEMINI_API_KEY=
# ACHILLES_GEMINI_MODEL=gemini-2.5-flash
# ACHILLES_ANTHROPIC_API_KEY=
# ACHILLES_ANTHROPIC_MODEL=claude-sonnet-5-5
